{
	email {$TLS_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

# Umumiy xavfsizlik sarlavhalari — ikkala sayt ham ishlatadi.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# ── API (backend) ────────────────────────────────────────────────────────────
{$DOMAIN} {
	encode zstd gzip
	import security_headers

	# BE-26: Swagger tashqaridan doim yopiq — `SWAGGER_ENABLED=on` bo'lsa ham.
	# /api/docs* — UI, JS/CSS fayllari (swagger-ui-init.js ichida butun API
	# sxemasi bor), /api/docs-json va /api/docs-yaml. Caddy path matcheri
	# katta-kichik harfni farqlamaydi: /API/DOCS ham yopiladi (Express ham
	# farqlamaydi). Ichki tarmoqda Swagger kerak bo'lsa — api-gateway:3000 ga
	# to'g'ridan-to'g'ri (C4.6-RUNBOOK, BE-26).
	handle /api/docs* {
		respond 404
	}

	# So'rov qatoridagi yo'l "/" bilan boshlanmasa (masalan
	# `GET http:http://x/api/docs-json`), Caddy uni bo'sh yo'l deb ko'radi va
	# yuqoridagi qoida ishlamaydi, Express esa /api/docs-json deb o'qib
	# Swagger'ni beradi. Bunday so'rovlar backendga o'tkazilmaydi.
	@non_origin_form not path /*
	handle @non_origin_form {
		respond 400
	}

	# Yo'li "//" bilan boshlanadigan yoki "#" li so'rov (masalan
	# `GET //a@x/api/docs-json?#`): Caddy yo'lni tozalab `/a@x/api/docs-json` deb
	# ko'radi va /api/docs* qoidasi ishlamaydi, Express (parseurl → url.parse) esa
	# `//a@x` ni login@host deb tashlab, Swagger'ni beradi. Haqiqiy klient bunday
	# so'rov yubormaydi. Tekshiruv tozalanmagan yo'l va so'rov qatori bo'yicha —
	# `path` matcheri yo'lni oldin tozalaydi, shuning uchun bu yerda yaramaydi.
	@ambiguous_target expression `{http.request.uri.path}.startsWith("//") || {http.request.uri}.contains("#")`
	handle @ambiguous_target {
		respond 400
	}

	handle_path /media/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy api-gateway:3000 {
			health_uri /api/v1/health
			health_interval 10s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format json
	}
}

# ── Sotuvchi kabineti (frontend SPA) ─────────────────────────────────────────
# Konteyner alohida compose'da ko'tariladi va `marketplace_edge` tarmog'iga
# `frontend` aliasi bilan ulanadi (Marketplace-FrontEnd/docker-compose.prod.yml).
{$APP_DOMAIN} {
	encode zstd gzip
	import security_headers

	header {
		# SPA: skriptlar faqat o'z domenidan; antd inline uslub yozadi;
		# API chaqiruvlari va rasm faqat API domeniga ruxsat etilgan.
		#
		# API_ORIGIN — brauzer ko'radigan to'liq API manzili, sxemasi bilan
		# (masalan `https://api.example.com`). DOMAIN'dan alohida, chunki
		# Cloudflare Tunnel rejimida DOMAIN `http://api.example.com` bo'ladi
		# (TLS Cloudflare chekkasida tugaydi, Caddy tunnel ortida oddiy HTTP
		# beradi) — o'shanda `https://{$DOMAIN}` yozuvi `https://http://...`
		# ga aylanib CSP'ni buzardi.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$API_ORIGIN}; media-src 'self' blob: {$API_ORIGIN}; font-src 'self' data:; connect-src 'self' {$API_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	reverse_proxy frontend:8080

	log {
		output stdout
		format json
	}
}
