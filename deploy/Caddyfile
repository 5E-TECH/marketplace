{
	email {$TLS_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

# Umumiy xavfsizlik sarlavhalari — ikkala sayt ham ishlatadi.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# ── API (backend) ────────────────────────────────────────────────────────────
{$DOMAIN} {
	encode zstd gzip
	import security_headers

	handle_path /media/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy api-gateway:3000 {
			health_uri /api/v1/health
			health_interval 10s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format json
	}
}

# ── Sotuvchi kabineti (frontend SPA) ─────────────────────────────────────────
# Konteyner alohida compose'da ko'tariladi va `marketplace_edge` tarmog'iga
# `frontend` aliasi bilan ulanadi (Marketplace-FrontEnd/docker-compose.prod.yml).
{$APP_DOMAIN} {
	encode zstd gzip
	import security_headers

	header {
		# SPA: skriptlar faqat o'z domenidan; antd inline uslub yozadi;
		# API chaqiruvlari va rasm faqat API domeniga ruxsat etilgan.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$DOMAIN}; font-src 'self' data:; connect-src 'self' https://{$DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	reverse_proxy frontend:8080

	log {
		output stdout
		format json
	}
}
