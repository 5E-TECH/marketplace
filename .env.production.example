NODE_ENV=production
API_GATEWAY_PORT=3000
# API domeni (backend) va sotuvchi kabineti domeni (frontend SPA).
DOMAIN=api.marketplace.example.com
APP_DOMAIN=kabinet.marketplace.example.com
TLS_EMAIL=admin@marketplace.example.com
# Kabinet CSP'si (img-src/connect-src) uchun brauzer ko'radigan API manzili,
# sxemasi bilan. Bo'sh qolsa admin paneldagi rasm preview'lari (masalan banner
# rasmi) va API chaqiruvlari CSP tomonidan bloklanadi.
API_ORIGIN=https://api.marketplace.example.com

# Brauzerdan API'ga ulanishga ruxsat etilgan origin'lar (vergul bilan).
# Bo'sh qolsa productionda hech qaysi brauzer ulana olmaydi.
CORS_ORIGINS=https://kabinet.marketplace.example.com

# Mijozning haqiqiy IP'si (rate limit, audit jurnali) `X-Forwarded-For` dan
# olinadi. Ishonchli proksilar — ichki Docker tarmog'i (caddy, cloudflared,
# storefront) — kodda belgilangan, bu yerda sozlanmaydi. Eski
# `TRUST_PROXY_HOPS` endi o'qilmaydi. Batafsil: docs/C4.8-TRUST-PROXY.md

# Rate limiting — umumiy chegara. Auth endpointlarida qattiqroq (kodda).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# BE-36: bir nechta gateway nusxasi uchun umumiy rate limit (ixtiyoriy; bitta
# nusxada kerak emas). Yoqish: COMPOSE_PROFILES ga `redis` (tunnel bilan:
# `tunnel,redis`), parol — faqat harf, raqam, `_` va `-` (URL ga shundayligicha
# yoziladi), masalan `openssl rand -hex 24`. docs/BE-36-KOP-NUSXA.md
# COMPOSE_PROFILES=redis
# REDIS_PASSWORD=<openssl rand -hex 24>
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# Birinchi deploy uchun idempotent seed. Keyin bu secretlarni olib tashlang.
SEED_ADMIN_PHONE=+998901234567
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SEED_DEFAULT_CATEGORIES=true

# Migratsiya konteyner ko'tarilishida avtomat ishlasinmi.
# Katta jadvallarda nazoratli rollout uchun `false` qilib, alohida qadamda
# ishga tushiring (docs/C4.6-RUNBOOK.md).
DB_AUTO_MIGRATE=true

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=marketplace
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_NAME=elchi_marketplace

RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
RABBITMQ_URL=amqp://marketplace:REPLACE_WITH_URL_ENCODED_PASSWORD@rabbitmq:5672

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
MINIO_BUCKET=marketplace-media
MINIO_PUBLIC_URL=https://api.marketplace.example.com/media
# BE-08: kreativlar (admin yuklaydi) — fayl turlari va hajm chegarasi, MB
CREATIVE_VIDEO_TYPES=video/mp4,video/webm
CREATIVE_VIDEO_MAX_MB=100
CREATIVE_IMAGE_TYPES=image/jpeg,image/png,image/webp
CREATIVE_IMAGE_MAX_MB=10
# Yuklash policy sini imzolovchi alohida MinIO foydalanuvchisi — faqat s3:PutObject
# arn:aws:s3:::<MINIO_BUCKET>/creative-uploads/* (root kaliti adminlarga ko'rinmasin). Bo'sh — MINIO_ACCESS_KEY.
CREATIVE_UPLOAD_ACCESS_KEY=
CREATIVE_UPLOAD_SECRET_KEY=

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d
# false — tokenlar body'da qaytmaydi, faqat HttpOnly cookie'da: XSS tokenni
# o'qiy olmaydi. Serverda false qilishdan OLDIN API_CONTRACT §2.2.1 dagi
# frontend ro'yxatini tekshiring (X-Requested-With, storefront proksisi
# /auth/refresh) — aks holda kirgan xaridor va sotuvchi so'rovlari 403 oladi.
AUTH_TOKENS_IN_BODY=false

INTEGRATION_CREDENTIAL_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ELCHI_PARTNER_API_URL=https://api.elchipochta.uz

# ── Lid-sotuv (lead-service) ──
# Sotuvchi sahifasi domeni (EQ-05): tayyor havola shu manzil + kod. Bo'sh qolsa havola nisbiy bo'ladi.
LEAD_LANDING_BASE_URL=https://REPLACE_WITH_LANDING_DOMAIN
# Operator kodlari (LID-2, BE-12), vergul bilan — ro'yxatni ega tasdiqlaydi; bo'sh — faqat +998 va 9 raqam
LEAD_PHONE_OPERATOR_CODES=
# lead.confirmed va eslatmalarni RMQ ga yuborish (BE-13): qabul qiluvchilar (BE-18) tayyor bo'lgach 'on'
LEAD_OUTBOX_RELAY=
ELCHI_PARTNER_API_KEY=REPLACE_WITH_ELCHI_PARTNER_API_KEY
# BE-46: kunlik avtomatik Elchi tekshiruvi (finance, 10:00 Toshkent) — posilka holati va pulini Elchi partner API
# dan olib solishtiradi; farq moliya → Elchi sverkasida. Qo‘lda ishga tushirish bayroqdan qat’i nazar ishlaydi.
ELCHI_STATUS_CHECK=on
ELCHI_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Monitoring: {service,status,detail,timestamp} JSON qabul qiluvchi webhook.
# Slack/Discord uchun shu payloadni moslashtiruvchi adapter kerak.
ALERT_WEBHOOK_URL=https://monitoring.example.com/hooks/replace-me
MONITOR_INTERVAL_MS=30000
MONITOR_FAILURE_THRESHOLD=3
# BE-26: ko'rsatkich ogohlantirishlari (Elchi API xatolari, lid navbati) — gateway GET /api/v1/health/ops.
# Gateway'da MONITOR_TOKEN, monitorda MONITOR_OPS_TOKEN — bir xil, kamida 16 belgi. Chegaralar: karta TC3 va TZ KPI.
MONITOR_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MONITOR_OPS_TOKEN=REPLACE_WITH_THE_SAME_VALUE_AS_MONITOR_TOKEN
MONITOR_ELCHI_ERRORS_5M_MAX=10
MONITOR_LEAD_QUEUE_MAX_AGE_MIN=10

# BE-26 (T8): prod'da Swagger yopiq (sukut). Ichki tarmoqda kerak bo'lsa on va Caddy'da tashqaridan yoping.
SWAGGER_ENABLED=off

# BE-26 (T8): admin va moliya uchun 2FA (TOTP). FE-27 (login'da kod, QR) chiqquncha off.
ADMIN_2FA=off
# TOTP sirlarini shifrlash kaliti — alohida, JWT sirlaridan mustaqil (JWT almashtirilsa 2FA buzilmasin).
TWO_FACTOR_SECRET_KEY=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS

# BE-25: sotuvchi JShShIR ini shifrlash kaliti (gateway va finance-service; kamida 32 belgi). Bir marta qo'yiladi:
# almashtirilsa eski raqamlar ochilmaydi. Bo'sh bo'lsa sotuvchi arizasi qabul qilinmaydi (503), qolgani ishlaydi.
SELF_EMPLOYED_SECRET_KEY=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS

# Backup retention (kun)
BACKUP_KEEP_DAYS=14
# BE-26 (T8): kunlik zaxira O'zbekiston ichidagi boshqa serverga — user@host:/katalog; kalit faqat shu foydalanuvchiga.
BACKUP_REMOTE=backup@REPLACE_BACKUP_HOST:/srv/elchi-backups
BACKUP_SSH_KEY=/srv/marketplace/.ssh/backup_ed25519
BACKUP_REMOTE_REQUIRED=on

# Notification provider adapterlari (ixtiyoriy)
# EMAIL_WEBHOOK_URL=https://notification-provider.example.com/email
# SMS_WEBHOOK_URL=https://notification-provider.example.com/sms
# TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# ── Qaytarish (C4.2) ──
# Posilka yetkazilgandan keyin necha kun ichida xaridor qaytarish so'rovi yubora oladi.
RETURN_WINDOW_DAYS=10
