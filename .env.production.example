NODE_ENV=production
API_GATEWAY_PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=marketplace
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_NAME=elchi_marketplace

RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
RABBITMQ_URL=amqp://marketplace:REPLACE_WITH_URL_ENCODED_PASSWORD@rabbitmq:5672

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
MINIO_BUCKET=marketplace-media
MINIO_PUBLIC_URL=http://169.58.98.223/media

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d

INTEGRATION_CREDENTIAL_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ELCHI_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

