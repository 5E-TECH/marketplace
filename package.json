{
  "name": "elchi-marketplace",
  "version": "0.1.0",
  "description": "Elchi Marketplace — standalone multi-vendor marketplace (NestJS mikroservis monorepo)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "nest build api-gateway && nest build echo-service && nest build identity-service && nest build catalog-service && nest build inventory-service && nest build checkout-service && nest build payment-service && nest build finance-service && nest build file-service && nest build notification-service && nest build search-service && nest build elchi-integration",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.ts\"",
    "prepare": "husky",
    "start": "nest start",
    "start:dev": "nest start api-gateway --watch",
    "start:echo:dev": "nest start echo-service --watch",
    "start:identity:dev": "nest start identity-service --watch",
    "start:catalog:dev": "nest start catalog-service --watch",
    "start:inventory:dev": "nest start inventory-service --watch",
    "start:checkout:dev": "nest start checkout-service --watch",
    "start:payment:dev": "nest start payment-service --watch",
    "start:finance:dev": "nest start finance-service --watch",
    "start:file:dev": "nest start file-service --watch",
    "start:notification:dev": "nest start notification-service --watch",
    "start:search:dev": "nest start search-service --watch",
    "start:integration:dev": "nest start elchi-integration --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/apps/api-gateway/src/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:inventory": "jest apps/inventory-service --runInBand",
    "test:inventory:integration": "jest apps/inventory-service/src/inventory.concurrency.spec.ts --runInBand",
    "test:inventory:coverage": "jest apps/inventory-service --runInBand --coverage --collectCoverageFrom=apps/inventory-service/src/inventory.service.ts --collectCoverageFrom=apps/inventory-service/src/reservation-sweeper.service.ts --coverageThreshold='{\"global\":{\"branches\":55,\"functions\":90,\"lines\":85,\"statements\":85}}'",
    "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
    "contract:export": "node scripts/export-openapi.mjs",
    "ops:monitor": "node scripts/health-monitor.mjs",
    "ops:backup": "sh scripts/db-backup.sh",
    "ops:restore-test": "sh scripts/db-restore-test.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "minio": "^8.0.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "decode-uri-component": "^0.5.0"
  }
}
