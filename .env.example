# ============================================================================
# Elchi Marketplace — muhit sozlamalari (namuna).
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring:  cp .env.example .env
# .env HECH QACHON git'ga commit qilinmaydi (.gitignore).
# Joi (libs/common/config) ishga tushishda tekshiradi — majburiy qiymat yo'q bo'lsa
# dastur ishga tushmaydi.
# ============================================================================

# ── Umumiy ──
NODE_ENV=development
API_GATEWAY_PORT=3000
# Productionda frontend domenlarini vergul bilan ajrating.
# CORS_ORIGINS=https://marketplace.example.com,https://admin.example.com

# ── PostgreSQL (1 instance, 9 schema — docs/schema/00-bootstrap.sql) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=marketplace
DB_PASSWORD=marketplace_dev_pass
DB_NAME=elchi_marketplace

# ── RabbitMQ (servislararo xabar) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── MinIO (media/rasm) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=marketplace-media
MINIO_PUBLIC_URL=http://localhost:9000
# BE-08: kreativlar (admin yuklaydi) — fayl turlari va hajm chegarasi, MB
CREATIVE_VIDEO_TYPES=video/mp4,video/webm
CREATIVE_VIDEO_MAX_MB=100
CREATIVE_IMAGE_TYPES=image/jpeg,image/png,image/webp
CREATIVE_IMAGE_MAX_MB=10

# ── Auth (JWT) — API_CONTRACT.md §2 ──
JWT_SECRET=change_me_dev_access_secret_min16
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min16
JWT_REFRESH_EXPIRES_IN=7d
# false — tokenlar body'da qaytmaydi, faqat HttpOnly cookie'da (API_CONTRACT §2.2.1).
# Frontend cookie rejimiga to'liq o'tgach false qiling.
AUTH_TOKENS_IN_BODY=true

# ── Integratsiya kalitlari shifri (provider/partner secret AES) ──
INTEGRATION_CREDENTIAL_SECRET=change_me_dev_aes_secret_min16
ELCHI_WEBHOOK_SECRET=change_me_elchi_webhook_secret_min16

# ── Elchi Partner API (elchi-integration servisi) ──
ELCHI_PARTNER_API_URL=https://api.elchi.uz
ELCHI_PARTNER_API_KEY=elp_your_partner_api_key_here

# ── Lid-sotuv (lead-service) ──
# Sotuvchi sahifasi domeni: tayyor havola shu manzil + kod (EQ-05; masalan https://<domen>)
LEAD_LANDING_BASE_URL=
# Operator kodlari (LID-2, BE-12), vergul bilan — ro'yxatni ega tasdiqlaydi; bo'sh — faqat +998 va 9 raqam
LEAD_PHONE_OPERATOR_CODES=
# lead.confirmed va eslatmalarni RMQ ga yuborish (BE-13): qabul qiluvchilar (BE-18) tayyor bo'lgach 'on'
LEAD_OUTBOX_RELAY=
# BE-31 Meta Conversions API: on bo'lsa capi_delivery navbati yuboriladi
LEAD_CAPI=
# Xeshlangan telefon (ph) — EQ-10 yuridik tekshiruvidan keyin on (T01:473); sukut o'chiq
LEAD_CAPI_SEND_PHONE=
# Graph API versiyasi (bo'sh — v26.0)
META_GRAPH_VERSION=
# Faqat QA muhitida: Meta Events Manager test kodi (prodda bo'sh qoldiring)
LEAD_CAPI_TEST_EVENT_CODE=

# ── Notification adapterlari (ixtiyoriy) ──
# Email/SMS gateway JSON qabul qiladi: recipient, title, body.
# EMAIL_WEBHOOK_URL=https://notification-provider.example.com/email
# SMS_WEBHOOK_URL=https://notification-provider.example.com/sms
# TELEGRAM_BOT_TOKEN=123456:telegram_bot_token

# ── Qaytarish (C4.2) ──
# Posilka yetkazilgandan keyin necha kun ichida xaridor qaytarish so'rovi yubora oladi.
RETURN_WINDOW_DAYS=10

# ── Boshlang'ich SELLER seed (ixtiyoriy — faqat ikkalasi berilsa yaratiladi) ──
# SEED_ADMIN_PHONE=+998900000000
# SEED_ADMIN_PASSWORD=change_me_admin_pass
