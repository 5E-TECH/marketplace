# ============================================================================
# Elchi Marketplace — muhit sozlamalari (namuna).
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring:  cp .env.example .env
# .env HECH QACHON git'ga commit qilinmaydi (.gitignore).
# Joi (libs/common/config) ishga tushishda tekshiradi — majburiy qiymat yo'q bo'lsa
# dastur ishga tushmaydi.
# ============================================================================

# ── Umumiy ──
NODE_ENV=development
API_GATEWAY_PORT=3000
# Productionda frontend domenlarini vergul bilan ajrating.
# CORS_ORIGINS=https://marketplace.example.com,https://admin.example.com

# ── PostgreSQL (1 instance, 9 schema — docs/schema/00-bootstrap.sql) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=marketplace
DB_PASSWORD=marketplace_dev_pass
DB_NAME=elchi_marketplace

# ── RabbitMQ (servislararo xabar) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── MinIO (media/rasm) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=marketplace-media
MINIO_PUBLIC_URL=http://localhost:9000

# ── Auth (JWT) — API_CONTRACT.md §2 ──
JWT_SECRET=change_me_dev_access_secret_min16
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min16
JWT_REFRESH_EXPIRES_IN=7d

# ── Integratsiya kalitlari shifri (provider/partner secret AES) ──
INTEGRATION_CREDENTIAL_SECRET=change_me_dev_aes_secret_min16
ELCHI_WEBHOOK_SECRET=change_me_elchi_webhook_secret_min16

# ── Elchi Partner API (elchi-integration servisi) ──
ELCHI_PARTNER_API_URL=https://api.elchi.uz
ELCHI_PARTNER_API_KEY=elp_your_partner_api_key_here

# ── Notification adapterlari (ixtiyoriy) ──
# Email/SMS gateway JSON qabul qiladi: recipient, title, body.
# EMAIL_WEBHOOK_URL=https://notification-provider.example.com/email
# SMS_WEBHOOK_URL=https://notification-provider.example.com/sms
# TELEGRAM_BOT_TOKEN=123456:telegram_bot_token

# ── Boshlang'ich SELLER seed (ixtiyoriy — faqat ikkalasi berilsa yaratiladi) ──
# SEED_ADMIN_PHONE=+998900000000
# SEED_ADMIN_PASSWORD=change_me_admin_pass
